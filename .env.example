# Copy to .env if you want any of these. .env is git-ignored.
# Capri runs on Claude Code and uses its login: run `claude` once and /login.

# CAPRI_FAST_MODEL=claude-haiku-5-5  # quick replies (medium effort)
# CAPRI_DEEP_MODEL=claude-opus-5-5   # real jobs (high effort); she hands off to it herself
# CAPRI_MODEL=claude-opus-5-5        # pin one model instead of switching (same as /model)
# CAPRI_QUIP_MODEL=claude-haiku-5-5  # model for her one-line reactions
# CAPRI_CWD=C:/code/my-project       # folder she starts in (later: /cd or the tray menu)
# CAPRI_PORT=47913                   # local port the Claude Code hooks report to
# CAPRI_START_HIDDEN=1               # start in the tray, invisible until summoned
# CAPRI_DEBUG=1                      # open DevTools for the overlay, log Claude Code's stderr

# To bill an API key instead of your Claude login, set both. Without the
# second line an ANTHROPIC_API_KEY here is ignored, so a stale one can't
# break her sign-in.
# ANTHROPIC_API_KEY=sk-ant-...
# CAPRI_USE_API_KEY=1
